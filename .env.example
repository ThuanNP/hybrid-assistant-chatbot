# ==============================================================================
# Tệp biến môi trường mẫu cho hệ thống Trợ lý AI Nội bộ
# Chú thích: địa chỉ host.docker.internal và db là địa chỉ nhìn từ TRONG container;
# khi chạy kịch bản hoặc pytest trực tiếp trên máy, app/config.py tự đổi thành localhost (PROMPT 3).
# ==============================================================================

# Môi trường chạy ứng dụng (dev, prod)
MOI_TRUONG=dev

# Chế độ định tuyến mô hình (local_truoc, dam_may_truoc, chi_local)
CHE_DO_DINH_TUYEN=local_truoc

# Loại bộ chạy mô hình cục bộ: ollama hoặc lmstudio (viết liền, không gạch dưới)
LOAI_BO_CHAY=ollama

# Địa chỉ API bộ chạy nhìn từ trong container
DIA_CHI_BO_CHAY=http://host.docker.internal:11434/v1

# Hồ sơ GPU, là một khoá trong ho_so_gpu của config/models.yaml:
# gpu6, gpu8 (laptop GPU 8 GB), gpu12, gpu16, gpu24
HO_SO_GPU=gpu8

# Khoá API Google Gemini (giá trị mẫu giả)
GOOGLE_API_KEY=dan-khoa-that-vao-day

# Khoá API OpenRouter (giá trị mẫu giả)
OPENROUTER_API_KEY=dan-khoa-that-vao-day

# Khoá API Anthropic Claude (giá trị mẫu giả)
ANTHROPIC_API_KEY=dan-khoa-that-vao-day

# Khoá API OpenAI (giá trị mẫu giả)
OPENAI_API_KEY=dan-khoa-that-vao-day

# Chuỗi kết nối PostgreSQL (nhìn từ trong container dùng máy db); không có giá trị mặc định trong mã
DATABASE_URL=postgresql+psycopg://<user>:<mat-khau>@db:5432/<ten-db>

# Tên người dùng quản trị cơ sở dữ liệu PostgreSQL
POSTGRES_USER=dan-khoa-that-vao-day

# Mật khẩu người dùng cơ sở dữ liệu PostgreSQL
POSTGRES_PASSWORD=dan-khoa-that-vao-day

# Tên cơ sở dữ liệu PostgreSQL
POSTGRES_DB=dan-khoa-that-vao-day

# Khoá bí mật để ký và xác thực mã phiên / JWT; không có giá trị mặc định trong mã
APP_SECRET=dan-khoa-that-vao-day

# Danh sách nguồn được phép gọi API qua CORS (cách nhau bởi dấu phẩy)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Ngân sách gọi mô hình tối đa hàng ngày (tính bằng USD)
NGAN_SACH_NGAY_USD=10.0

# Số lời gọi model local chạy đồng thời. Để trống thì lấy num_parallel của hồ sơ GPU;
# nếu đặt, phải KHỚP OLLAMA_NUM_PARALLEL (đặt cao hơn chỉ đẩy hàng đợi vào trong bộ chạy)
SO_LUONG_DONG_THOI=

# Số yêu cầu tối đa được xếp hàng đợi local trước khi rơi sang đám mây hoặc từ chối
DO_DAI_HANG_DOI_TOI_DA=20

# Thời gian chờ phản hồi tối đa cho mỗi yêu cầu gọi mô hình (giây)
TIMEOUT_GIAY=60

# Bật/tắt ghi nội dung tin nhắn vào nhật ký (mặc định false để bảo mật)
GHI_NOI_DUNG=false

# Bật chế độ xác thực giả lập danh tính người dùng (chỉ áp dụng ở môi trường dev)
XAC_THUC_GIA=true
